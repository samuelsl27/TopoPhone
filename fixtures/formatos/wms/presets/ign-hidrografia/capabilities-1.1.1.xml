            <Format>image/png</Format>
            <OnlineResource xmlns:xlink="http://www.w3.org/1999/xlink" xlink:type="simple" xlink:href="https://servicios.idee.es/wms-inspire/hidrografia/leyendas/red_hidrografica.png"/>
          </LegendURL>
        </Style>
        <Style>
