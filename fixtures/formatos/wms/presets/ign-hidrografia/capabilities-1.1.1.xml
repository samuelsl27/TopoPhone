          <Title>IGN: Estilo de masas de agua y humedales</Title>
          <Abstract>Relleno azul #AED1FF sin borde. Etiqueta: bodoni 12</Abstract>
          <LegendURL width="20" height="20">
            <Format>image/png</Format>
            <OnlineResource xmlns:xlink="http://www.w3.org/1999/xlink" xlink:type="simple" xlink:href="https://servicios.idee.es/wms-inspire/hidrografia/leyendas/masas_agua.png"/>
