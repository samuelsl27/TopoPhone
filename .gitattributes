# Fin de línea: LF en el repo para todo el texto
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
gradlew text eol=lf

# Fixtures que deben conservarse byte a byte (NMEA termina en \r\n)
*.nmea -text
*.ubx binary
# Tablas de fuentes tal como las envía el caster (CRLF, ISO-8859-1)
*.sourcetable -text
# CSV exportados de referencia: CRLF y un salto de línea dentro de un campo, byte a byte (S012)
fixtures/formatos/csv/*.csv -text
# Ficheros de ejemplo de la importación: BOM, Windows-1252 y CRLF o LF tal como están, byte a byte (S028)
fixtures/formatos/csv-importacion/* -text
# DXF de ejemplo de la capa de diseño: CRLF y LF, Windows-1252 y UTF-8, ficheros cortados y binarios, byte a byte (S040)
fixtures/formatos/dxf/* -text
# GeoPackage de ejemplo de la importación: binarios y un texto con CRLF, byte a byte (S048)
fixtures/formatos/gpkg/* -text
# Shapefiles de ejemplo de la importación: binarios, Windows-1252, .prj sin salto de línea y CSV, byte a byte (S030)
fixtures/formatos/shp/** -text
# CSV esperados de los perfiles tomados: CRLF, byte a byte (S052)
fixtures/ejes/toma/esperado-perfil-*.csv -text

*.zip filter=lfs diff=lfs merge=lfs -text
*.nmea.gz filter=lfs diff=lfs merge=lfs -text
*.rtcm3.gz filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
*.gtx filter=lfs diff=lfs merge=lfs -text
*.gsb filter=lfs diff=lfs merge=lfs -text

# Rejillas geodésicas y grabaciones RTCM cortas (< 5 MB) en git normal, no en LFS: el CI las necesita.
*.tif binary
*.rtcm3 binary
# DXF y tabla ACI de referencia de la exportacion: CRLF byte a byte (S029)
fixtures/formatos/dxf-exportado/* -text
fixtures/formatos/shp-exportado/** -text
# KML y KMZ de ejemplo de la importacion: BOM, XML cortado, ZIP y CSV tal como estan, byte a byte (S031)
fixtures/formatos/kml/** -text
# KML de referencia de la exportacion: LF y UTF-8 tal como estan, byte a byte (S031)
fixtures/formatos/kml-exportado/** -text
# Indice y entrada del ZIP de fotos: CRLF y UTF-8 tal como estan, byte a byte (S056)
fixtures/formatos/fotos-zip/** -text
