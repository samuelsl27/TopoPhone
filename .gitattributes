# Fin de línea: LF en el repo para todo el texto
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
gradlew text eol=lf

# Fixtures que deben conservarse byte a byte (NMEA termina en \r\n)
*.nmea -text
*.ubx binary

*.zip filter=lfs diff=lfs merge=lfs -text
*.nmea.gz filter=lfs diff=lfs merge=lfs -text
*.rtcm3 filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.gtx filter=lfs diff=lfs merge=lfs -text
*.gsb filter=lfs diff=lfs merge=lfs -text
