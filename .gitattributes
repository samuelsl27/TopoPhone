# Fin de línea: LF en el repo para todo el texto
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
gradlew text eol=lf

# Fixtures que deben conservarse byte a byte (NMEA termina en \r\n)
*.nmea -text
*.ubx binary
# Tablas de fuentes tal como las envía el caster (CRLF, ISO-8859-1)
*.sourcetable -text
# CSV exportados de referencia: CRLF y un salto de línea dentro de un campo, byte a byte (S012)
fixtures/formatos/csv/*.csv -text
# Ficheros de ejemplo de la importación: BOM, Windows-1252 y CRLF o LF tal como están, byte a byte (S028)
fixtures/formatos/csv-importacion/* -text

*.zip filter=lfs diff=lfs merge=lfs -text
*.nmea.gz filter=lfs diff=lfs merge=lfs -text
*.rtcm3.gz filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
*.gtx filter=lfs diff=lfs merge=lfs -text
*.gsb filter=lfs diff=lfs merge=lfs -text

# Rejillas geodésicas y grabaciones RTCM cortas (< 5 MB) en git normal, no en LFS: el CI las necesita.
*.tif binary
*.rtcm3 binary
