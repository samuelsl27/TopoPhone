<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8–11: no se distingue nube de transferencia; se excluye todo de la copia (RNF-T6). -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
