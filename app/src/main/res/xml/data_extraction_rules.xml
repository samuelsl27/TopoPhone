<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: sin copia en la nube; sí transferencia entre dispositivos (RNF-T6). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer />
</data-extraction-rules>
